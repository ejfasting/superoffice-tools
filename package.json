{
  "workspaces": [
    "packages/language",
    "packages/vscode-extension"
  ],
  "type": "module",
  "scripts": {
    "vscode:bundle": "pnpm run -C ./packages/vscode-extension bundle",
    "vscode:package": "pnpm -C ./packages/vscode-extension run package",
    "vscode:publish": "pnpm -C ./packages/vscode-extension run publish",
    "vscode:publish:minor": "pnpm -C ./packages/vscode-extension run publish:minor",
    "vscode:publish:patch": "pnpm -C ./packages/vscode-extension run publish:patch",
    "prepare": "vp config",
    "langium:generate": "pnpm run -C ./packages/language langium:generate",
    "langium:build": "pnpm run -C ./packages/language build",
    "langium:bundle": "pnpm run -C ./packages/language bundle"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260115.1",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.1.3"
}
