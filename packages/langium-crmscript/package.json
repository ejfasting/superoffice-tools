{
  "name": "crmscript-language",
  "version": "0.0.1",
  "description": "The language specific package",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "langium:generate": "langium generate",
    "langium:watch": "langium generate --watch",
    "bundle": "vp run langium:generate && vp pack --sourcemap"
  },
  "dependencies": {
    "@ejfasting/script-core": "workspace:*",
    "langium": "catalog:"
  },
  "devDependencies": {
    "langium-cli": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vscode-languageserver": "catalog:"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=10.2.3"
  }
}
